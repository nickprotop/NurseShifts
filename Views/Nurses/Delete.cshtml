@model NurseShifts.Models.Nurse
@{
    ViewData["Title"] = Localizer["DeleteNurse"];
}

<div class="row mb-4">
    <div class="col">
        <h1><i class="bi bi-trash me-2 text-danger"></i>@Localizer["DeleteNurse"]</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle text-danger fs-1"></i>
                <h4 class="mt-3">@Localizer["AreYouSure"]</h4>
                <p class="text-muted">
                    <strong>@Model.FullName</strong>
                    <br />@Localizer["ActionCannotBeUndone"]
                </p>

                <div class="text-start bg-light p-3 rounded mb-3">
                    <small class="text-muted">
                        <strong>@Localizer["Clinic"]:</strong> @Model.PrimaryClinic?.Name<br />
                        <strong>@Localizer["Type"]:</strong> @Model.EmploymentType<br />
                        <strong>@Localizer["Level"]:</strong> @Model.SkillLevel
                    </small>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>@Localizer["Cancel"]
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>@Localizer["Delete"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
