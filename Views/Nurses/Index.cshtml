@model IEnumerable<NurseShifts.Models.Nurse>
@{
    ViewData["Title"] = Localizer["Nurses"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-people me-2"></i>@Localizer["Nurses"]</h1>
        <p class="text-muted mb-0">@Localizer["NursesSubtitle"]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>@Localizer["AddNurse"]
    </a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="clinicId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">@Localizer["AllClinics"]</option>
                    @foreach (var clinic in (IEnumerable<SelectListItem>)ViewBag.Clinics)
                    {
                        <option value="@clinic.Value" selected="@(clinic.Selected)">@clinic.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <div class="form-check form-check-inline">
                    <input type="checkbox" class="form-check-input" name="activeOnly" value="true"
                           id="activeOnly" onchange="this.form.submit()"
                           @(ViewBag.ActiveOnly == true ? "checked" : "") />
                    <label class="form-check-label" for="activeOnly">@Localizer["ActiveOnly"]</label>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Clinic"]</th>
                        <th>@Localizer["Type"]</th>
                        <th>@Localizer["Level"]</th>
                        <th>@Localizer["HoursWeek"]</th>
                        <th>@Localizer["Status"]</th>
                        <th width="150">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var nurse in Model)
                    {
                        <tr class="@(!nurse.IsActive ? "table-secondary" : "")">
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (nurse.CanHandleResponsibility)
                                    {
                                        <i class="bi bi-star-fill text-warning me-2" title="@Localizer["CanHandleResponsibility"]"></i>
                                    }
                                    @if (nurse.IsPoolNurse)
                                    {
                                        <span class="badge bg-info me-2" title="@Localizer["PoolNurse"]">P</span>
                                    }
                                    <div>
                                        <strong>@nurse.FullName</strong>
                                        @if (!string.IsNullOrEmpty(nurse.Email))
                                        {
                                            <br /><small class="text-muted">@nurse.Email</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@nurse.PrimaryClinic?.Name</td>
                            <td>
                                <span class="badge @(nurse.EmploymentType == NurseShifts.Models.EmploymentType.FullTime ? "bg-success" : nurse.EmploymentType == NurseShifts.Models.EmploymentType.PartTime ? "bg-warning text-dark" : "bg-secondary")">
                                    @nurse.EmploymentType
                                </span>
                            </td>
                            <td>
                                <span class="badge @(nurse.SkillLevel == NurseShifts.Models.SkillLevel.Senior ? "bg-primary" : nurse.SkillLevel == NurseShifts.Models.SkillLevel.Mid ? "bg-info" : "bg-light text-dark")">
                                    @nurse.SkillLevel
                                </span>
                            </td>
                            <td>@nurse.ContractedHoursPerWeek h</td>
                            <td>
                                @if (nurse.IsActive)
                                {
                                    <span class="badge bg-success">@Localizer["Active"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@nurse.Id" class="btn btn-outline-info" title="@Localizer["Details"]">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@nurse.Id" class="btn btn-outline-primary" title="@Localizer["Edit"]">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@nurse.Id" class="btn btn-outline-danger" title="@Localizer["Delete"]">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-people fs-1 text-muted"></i>
            <h5 class="mt-3">@Localizer["NoNursesFound"]</h5>
            <p class="text-muted">@Localizer["AddFirstNurse"]</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i>@Localizer["AddNurse"]
            </a>
        </div>
    </div>
}
