@model NurseShifts.Models.ViewModels.ScheduleViewModel
@{
    ViewData["Title"] = Localizer["Schedule"];

    // Build localized strings JSON for JavaScript
    var jsStrings = new Dictionary<string, string>
    {
        { "loading", Localizer["Loading"].Value },
        { "noNursesAvailable", Localizer["NoNursesAvailable"].Value },
        { "markAsManual", Localizer["MarkAsManual"].Value },
        { "markAsManualHelp", Localizer["MarkAsManualHelp"].Value },
        { "borrowed", Localizer["Borrowed"].Value },
        { "canHandleResponsibility", Localizer["CanHandleResponsibility"].Value },
        { "assign", Localizer["Assign"].Value },
        { "assignAsResponsible", Localizer["ResponsibleNurse"].Value },
        { "couldNotAssignNurse", Localizer["CouldNotAssignNurse"].Value },
        { "confirmRemoveManual", Localizer["ConfirmRemoveManual"].Value },
        { "updateFailed", Localizer["UpdateFailed"].Value },
        { "updating", Localizer["Updating"].Value },
        { "updateSuccess", Localizer["UpdateSuccess"].Value }
    };
}

<div id="schedule-container" data-strings='@System.Text.Json.JsonSerializer.Serialize(jsStrings)'>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-calendar3 me-2"></i>@Localizer["Schedule"]</h1>
        <p class="text-muted mb-0">
            @Model.Clinic?.Name - @Model.StartDate.ToString("MMM d") - @Model.StartDate.AddDays(Model.Days - 1).ToString("MMM d, yyyy")
        </p>
    </div>
</div>

@{
    // Navigation: move by weeks
    var prevDate = Model.StartDate.AddDays(-Model.Weeks * 7);
    var nextDate = Model.StartDate.AddDays(Model.Weeks * 7);
    // Today: go to Monday of current week
    var todayDate = DateOnly.FromDateTime(DateTime.Today);
    var daysFromMonday = ((int)todayDate.DayOfWeek - 1 + 7) % 7;
    var currentWeekMonday = todayDate.AddDays(-daysFromMonday);
}
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="clinicId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var clinic in (IEnumerable<SelectListItem>)ViewBag.Clinics)
                    {
                        <option value="@clinic.Value" selected="@(clinic.Value == Model.ClinicId.ToString())">@clinic.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <div class="btn-group btn-group-sm">
                    <a asp-action="Index" asp-route-clinicId="@Model.ClinicId"
                       asp-route-startDate="@prevDate.ToString("yyyy-MM-dd")" asp-route-weeks="@Model.Weeks"
                       class="btn btn-outline-secondary" title="@Localizer["PreviousWeek"]">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <a asp-action="Index" asp-route-clinicId="@Model.ClinicId"
                       asp-route-startDate="@currentWeekMonday.ToString("yyyy-MM-dd")" asp-route-weeks="@Model.Weeks"
                       class="btn btn-outline-secondary">
                        @Localizer["Today"]
                    </a>
                    <a asp-action="Index" asp-route-clinicId="@Model.ClinicId"
                       asp-route-startDate="@nextDate.ToString("yyyy-MM-dd")" asp-route-weeks="@Model.Weeks"
                       class="btn btn-outline-secondary" title="@Localizer["NextWeek"]">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-auto">
                <input type="date" name="startDate" class="form-control form-control-sm"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>
            <div class="col-auto">
                <div class="btn-group btn-group-sm">
                    <a asp-action="Index" asp-route-clinicId="@Model.ClinicId"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-weeks="1"
                       class="btn @(Model.Weeks == 1 ? "btn-primary" : "btn-outline-primary")">1 @Localizer["Week"]</a>
                    <a asp-action="Index" asp-route-clinicId="@Model.ClinicId"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-weeks="2"
                       class="btn @(Model.Weeks == 2 ? "btn-primary" : "btn-outline-primary")">2 @Localizer["Weeks"]</a>
                    <a asp-action="Index" asp-route-clinicId="@Model.ClinicId"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-weeks="3"
                       class="btn @(Model.Weeks == 3 ? "btn-primary" : "btn-outline-primary")">3 @Localizer["Weeks"]</a>
                    <a asp-action="Index" asp-route-clinicId="@Model.ClinicId"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-weeks="4"
                       class="btn @(Model.Weeks == 4 ? "btn-primary" : "btn-outline-primary")">4 @Localizer["Weeks"]</a>
                </div>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-group btn-group-sm">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-download me-1"></i>@Localizer["Export"]
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="javascript:window.print()">
                                    <i class="bi bi-printer me-1"></i>@Localizer["Print"]
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-action="ExportPdf" asp-route-clinicId="@Model.ClinicId"
                                   asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-weeks="@Model.Weeks">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>@Localizer["ExportPdf"]
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-action="ExportExcel" asp-route-clinicId="@Model.ClinicId"
                                   asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-weeks="@Model.Weeks">
                                    <i class="bi bi-file-earmark-excel me-1"></i>@Localizer["ExportExcel"]
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <form asp-action="Schedule" method="post" class="d-inline">
                    <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                    <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="weeks" value="@Model.Weeks" />
                    <button type="submit" class="btn btn-primary btn-sm" title="@Localizer["AutoScheduleHelp"]">
                        <i class="bi bi-magic me-1"></i>@Localizer["AutoSchedule"]
                    </button>
                </form>
                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#clearRebuildModal">
                    <i class="bi bi-arrow-repeat me-1"></i>@Localizer["ClearAndRebuild"]
                </button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.ScheduleResult != null)
{
    var scheduleResult = (NurseShifts.Services.ScheduleResult)ViewBag.ScheduleResult;
    <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-info-circle me-1"></i>
        <strong>@Localizer["ScheduleUpdated"]:</strong>
        @if (scheduleResult.AssignmentsAdded > 0)
        {
            <span class="me-2">+@scheduleResult.AssignmentsAdded @Localizer["Added"]</span>
        }
        @if (scheduleResult.AssignmentsRemoved > 0)
        {
            <span class="text-danger me-2">-@scheduleResult.AssignmentsRemoved @Localizer["Removed"]</span>
        }
        @if (scheduleResult.CompDaysGranted > 0)
        {
            <span class="text-success me-2">🏖️ @scheduleResult.CompDaysGranted @Localizer["CompDaysGranted"]</span>
        }
        @if (scheduleResult.CompDaysRevoked > 0)
        {
            <span class="text-warning">↩️ @scheduleResult.CompDaysRevoked @Localizer["CompDaysRevoked"]</span>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i>
        @Localizer[TempData["Error"].ToString()!]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-bordered mb-0 schedule-table">
            <thead class="table-light">
                <tr>
                    <th width="100">@Localizer["ShiftType"]</th>
                    @foreach (var day in Model.DaySchedules)
                    {
                        var isWeekend = day.Date.DayOfWeek == DayOfWeek.Saturday || day.Date.DayOfWeek == DayOfWeek.Sunday;
                        var isToday = day.Date == todayDate;
                        var isPast = day.Date < todayDate;
                        var isWeekStart = day.Date.DayOfWeek == DayOfWeek.Monday;
                        var temporalClass = isToday ? "is-today" : (isPast ? "is-past" : "is-future");
                        <th class="text-center @(isWeekend ? "bg-light" : "") @temporalClass @(isWeekStart ? "week-start" : "")" style="min-width: 120px;">
                            <div class="small text-muted">@day.Date.DayOfWeek.ToString().Substring(0, 3)</div>
                            <div>@day.Date.ToString("MMM d")</div>
                            @if (isToday)
                            {
                                <span class="badge bg-primary" style="font-size: 0.6rem;">@Localizer["Today"]</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var shiftType in Enum.GetValues<NurseShifts.Models.ShiftType>())
                {
                    var icon = shiftType switch
                    {
                        NurseShifts.Models.ShiftType.Morning => "bi-sunrise text-warning",
                        NurseShifts.Models.ShiftType.Afternoon => "bi-sun text-info",
                        NurseShifts.Models.ShiftType.Night => "bi-moon text-dark",
                        _ => "bi-clock"
                    };
                    var shiftName = shiftType switch
                    {
                        NurseShifts.Models.ShiftType.Morning => Localizer["Morning"].Value,
                        NurseShifts.Models.ShiftType.Afternoon => Localizer["Afternoon"].Value,
                        NurseShifts.Models.ShiftType.Night => Localizer["Night"].Value,
                        _ => shiftType.ToString()
                    };
                    var timeRange = shiftType switch
                    {
                        NurseShifts.Models.ShiftType.Morning => "07-15",
                        NurseShifts.Models.ShiftType.Afternoon => "15-23",
                        NurseShifts.Models.ShiftType.Night => "23-07",
                        _ => ""
                    };
                    <tr>
                        <td class="align-middle">
                            <i class="bi @icon me-1"></i>
                            <strong>@shiftName</strong>
                            <br /><small class="text-muted">@timeRange</small>
                        </td>
                        @foreach (var day in Model.DaySchedules)
                        {
                            var shift = day.Shifts.FirstOrDefault(s => s.ShiftType == shiftType);
                            var isWeekend = day.Date.DayOfWeek == DayOfWeek.Saturday || day.Date.DayOfWeek == DayOfWeek.Sunday;
                            var isToday = day.Date == todayDate;
                            var isPast = day.Date < todayDate;
                            var isWeekStart = day.Date.DayOfWeek == DayOfWeek.Monday;
                            var temporalClass = isToday ? "is-today" : (isPast ? "is-past" : "is-future");
                            var cellClass = "";
                            if (shift != null && !shift.IsValid)
                            {
                                cellClass = shift.Errors.Any() ? "table-danger" : "table-warning";
                            }
                            var isShiftEmpty = shift != null && shift.RequiredNurses > 0 && shift.Assignments.Count == 0;
                            <td class="@cellClass @(isWeekend ? "bg-light bg-opacity-50" : "") @temporalClass @(isWeekStart ? "week-start" : "") @(isShiftEmpty && !isPast ? "shift-empty" : "")"
                                data-clinic="@Model.ClinicId" data-date="@day.Date.ToString("yyyy-MM-dd")" data-shift="@shiftType">

                                @if (shift != null)
                                {
                                    <div class="shift-cell">
                                        @* Status Badge *@
                                        @{
                                            var statusClass = shift.Assignments.Count >= shift.RequiredNurses ? "status-full"
                                                : (shift.Assignments.Count > 0 ? "status-partial" : "status-empty");
                                            var statusText = shift.Assignments.Count >= shift.RequiredNurses ? "OK"
                                                : (shift.Assignments.Count > 0 ? $"-{shift.RequiredNurses - shift.Assignments.Count}" : "EMPTY");
                                        }
                                        @if (shift.RequiredNurses > 0)
                                        {
                                            <span class="shift-status-badge @statusClass">@statusText</span>
                                        }

                                        @if (shift.Assignments.Any())
                                        {
                                            <ul class="list-unstyled mb-1">
                                                @foreach (var assignment in shift.Assignments)
                                                {
                                                    <li class="d-flex align-items-center justify-content-between mb-1 assignment-item @(assignment.IsResponsibleNurse ? "is-responsible" : "")"
                                                        data-assignment-id="@assignment.Id"
                                                        data-is-manual="@assignment.IsManualAssignment.ToString().ToLower()">
                                                        <span class="small">
                                                            @if (assignment.IsManualAssignment)
                                                            {
                                                                <i class="bi bi-lock-fill text-primary toggle-manual" title="@Localizer["ManualAssignment"] - @Localizer["ClickToUnlock"]" style="cursor:pointer"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-unlock text-muted toggle-manual" title="@Localizer["AutoAssignment"] - @Localizer["ClickToLock"]" style="cursor:pointer"></i>
                                                            }
                                                            @if (assignment.IsResponsibleNurse)
                                                            {
                                                                <i class="bi bi-star-fill text-warning" title="@Localizer["ResponsibleNurse"]"></i>
                                                            }
                                                            @if (assignment.IsBorrowed)
                                                            {
                                                                <span class="badge bg-secondary badge-sm" title="@Localizer["Borrowed"]">B</span>
                                                            }
                                                            @assignment.Nurse?.ShortName
                                                        </span>
                                                        <button type="button" class="btn btn-link btn-sm text-danger p-0 remove-assignment"
                                                                title="@Localizer["Delete"]">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        }

                                        @{
                                            var coveragePercent = shift.RequiredNurses > 0
                                                ? Math.Min(100, (int)(shift.Assignments.Count * 100.0 / shift.RequiredNurses))
                                                : 100;
                                            var coverageClass = coveragePercent >= 100 ? "full" : (coveragePercent > 0 ? "partial" : "empty");
                                        }
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="flex-grow-1 me-2">
                                                <div class="coverage-progress" title="@shift.Assignments.Count / @shift.RequiredNurses @Localizer["Nurses"]">
                                                    <div class="coverage-progress-bar @coverageClass" style="width: @coveragePercent%"></div>
                                                </div>
                                            </div>
                                            <small class="text-muted coverage-count">
                                                @shift.Assignments.Count/@shift.RequiredNurses
                                            </small>
                                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 add-nurse-btn"
                                                    title="@Localizer["AddNurseToShift"]">
                                                <i class="bi bi-plus-circle"></i>
                                            </button>
                                        </div>

                                        @if (shift.Errors.Any() || shift.Warnings.Any())
                                        {
                                            <div class="mt-1 validation-messages">
                                                @foreach (var error in shift.Errors)
                                                {
                                                    <div class="text-danger small validation-message" title="@error">
                                                        <i class="bi bi-exclamation-circle"></i> @error
                                                    </div>
                                                }
                                                @foreach (var warning in shift.Warnings)
                                                {
                                                    <div class="text-warning small validation-message" title="@warning">
                                                        <i class="bi bi-exclamation-triangle"></i> @warning
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Workload Panel -->
<div class="card mt-3" id="workloadCard">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <h6 class="mb-0">
            <i class="bi bi-bar-chart me-1"></i>@Localizer["Workload"]
        </h6>
        <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#workloadContent" aria-expanded="false" id="workloadToggle">
            <span class="show-text">@Localizer["ShowWorkload"]</span>
            <span class="hide-text" style="display:none">@Localizer["HideWorkload"]</span>
            <i class="bi bi-chevron-down"></i>
        </button>
    </div>
    <div class="collapse" id="workloadContent"
         data-clinic="@Model.ClinicId"
         data-start-date="@Model.StartDate.ToString("yyyy-MM-dd")"
         data-weeks="@Model.Weeks">
        <div class="card-body py-2">
            <div id="workloadPanelContent">
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    @Localizer["Loading"]...
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h6>@Localizer["Legend"]</h6>
        <span class="me-3"><i class="bi bi-lock-fill text-primary"></i> @Localizer["ManualAssignment"]</span>
        <span class="me-3"><i class="bi bi-unlock text-muted"></i> @Localizer["AutoAssignment"]</span>
        <span class="me-3"><i class="bi bi-star-fill text-warning"></i> @Localizer["ResponsibleNurse"]</span>
        <span class="me-3"><span class="badge bg-secondary">B</span> @Localizer["BorrowedFromOtherClinic"]</span>
        <span class="me-3 text-danger"><i class="bi bi-exclamation-circle"></i> @Localizer["ErrorMustFix"]</span>
        <span class="me-3 text-warning"><i class="bi bi-exclamation-triangle"></i> @Localizer["Warning"]</span>
    </div>
</div>

<!-- Clear & Rebuild Modal -->
<div class="modal fade" id="clearRebuildModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger bg-opacity-25">
                <h5 class="modal-title"><i class="bi bi-arrow-repeat me-2"></i>@Localizer["ClearAndRebuild"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ClearAndRebuild" method="post">
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>@Localizer["Warning"]:</strong> @Localizer["ClearAndRebuildWarning"]
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-1"></i>
                        @Localizer["ClearAndRebuildInfoManual"]
                    </div>

                    <input type="hidden" name="clinicId" value="@Model.ClinicId" />

                    <div class="mb-3">
                        <label class="form-label">@Localizer["StartDate"]</label>
                        <input type="date" name="startDate" class="form-control"
                               value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["WeeksToGenerate"]</label>
                        <select name="weeks" class="form-select">
                            <option value="1">1 @Localizer["Week"]</option>
                            <option value="2">2 @Localizer["Weeks"]</option>
                            <option value="3">3 @Localizer["Weeks"]</option>
                            <option value="4" selected>4 @Localizer["Weeks"]</option>
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="recalculateCompDays" value="true" id="recalcCompDays">
                        <label class="form-check-label" for="recalcCompDays">
                            @Localizer["RecalculateCompDays"]
                        </label>
                        <div class="form-text">@Localizer["RecalculateCompDaysHelp"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-arrow-repeat me-1"></i>@Localizer["ClearAndRebuild"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Nurse Modal -->
<div class="modal fade" id="addNurseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>@Localizer["AddNurseToShift"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="availableNursesList">
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        @Localizer["Loading"]...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div> <!-- end schedule-container -->

@section Styles {
    <link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schedule-print.css" asp-append-version="true" media="print" />
}

@section Scripts {
    <script src="~/js/schedule.js" asp-append-version="true"></script>
}
