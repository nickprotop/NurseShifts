@model IEnumerable<NurseShifts.Models.NurseLeave>
@{
    ViewData["Title"] = Localizer["LeaveRequests"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-calendar-x me-2"></i>@Localizer["LeaveRequests"]</h1>
        <p class="text-muted mb-0">@Localizer["LeaveRequestsSubtitle"]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>@Localizer["RecordLeave"]
    </a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <select name="nurseId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">@Localizer["AllNurses"]</option>
                    @foreach (var nurse in (IEnumerable<SelectListItem>)ViewBag.Nurses)
                    {
                        <option value="@nurse.Value" selected="@(nurse.Selected)">@nurse.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <div class="btn-group btn-group-sm">
                    <a asp-action="Index" class="btn @(ViewBag.StatusFilter == null ? "btn-primary" : "btn-outline-primary")">@Localizer["All"]</a>
                    <a asp-action="Index" asp-route-status="Pending" class="btn @(ViewBag.StatusFilter?.ToString() == "Pending" ? "btn-warning" : "btn-outline-warning")">@Localizer["Pending"]</a>
                    <a asp-action="Index" asp-route-status="Approved" class="btn @(ViewBag.StatusFilter?.ToString() == "Approved" ? "btn-success" : "btn-outline-success")">@Localizer["Approved"]</a>
                    <a asp-action="Index" asp-route-status="Rejected" class="btn @(ViewBag.StatusFilter?.ToString() == "Rejected" ? "btn-danger" : "btn-outline-danger")">@Localizer["Rejected"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Nurse"]</th>
                        <th>@Localizer["Type"]</th>
                        <th>@Localizer["StartDate"]</th>
                        <th>@Localizer["EndDate"]</th>
                        <th>@Localizer["Days"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Notes"]</th>
                        <th width="180">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model)
                    {
                        var days = leave.EndDate.DayNumber - leave.StartDate.DayNumber + 1;
                        var isPast = leave.EndDate < DateOnly.FromDateTime(DateTime.Today);
                        <tr class="@(isPast ? "table-secondary" : "")">
                            <td>
                                <a asp-controller="Nurses" asp-action="Details" asp-route-id="@leave.NurseId">
                                    @leave.Nurse?.FullName
                                </a>
                            </td>
                            <td>
                                @{
                                    var typeClass = leave.LeaveType switch
                                    {
                                        NurseShifts.Models.LeaveType.Sick => "bg-danger",
                                        NurseShifts.Models.LeaveType.Vacation => "bg-success",
                                        NurseShifts.Models.LeaveType.Personal => "bg-info",
                                        NurseShifts.Models.LeaveType.Maternity => "bg-primary",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @typeClass">@leave.LeaveType</span>
                            </td>
                            <td>@leave.StartDate.ToString("MMM d, yyyy")</td>
                            <td>@leave.EndDate.ToString("MMM d, yyyy")</td>
                            <td>@days @Localizer["Days"]</td>
                            <td>
                                @{
                                    var statusClass = leave.Status switch
                                    {
                                        NurseShifts.Models.LeaveStatus.Pending => "bg-warning text-dark",
                                        NurseShifts.Models.LeaveStatus.Approved => "bg-success",
                                        NurseShifts.Models.LeaveStatus.Rejected => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusClass">@leave.Status</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(leave.Notes))
                                {
                                    <span title="@leave.Notes">
                                        <i class="bi bi-chat-left-text text-muted"></i>
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    @if (leave.Status == NurseShifts.Models.LeaveStatus.Pending)
                                    {
                                        <form asp-action="Approve" asp-route-id="@leave.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-success" title="@Localizer["Approve"]">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@leave.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger" title="@Localizer["Reject"]">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@leave.Id" class="btn btn-outline-primary" title="@Localizer["Edit"]">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@leave.Id" class="btn btn-outline-danger" title="@Localizer["Delete"]">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-check fs-1 text-muted"></i>
            <h5 class="mt-3">@Localizer["NoLeaveRequests"]</h5>
            <p class="text-muted">@Localizer["RecordLeaveWhenAbsent"]</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>@Localizer["RecordLeave"]
            </a>
        </div>
    </div>
}
