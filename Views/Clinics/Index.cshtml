@model IEnumerable<NurseShifts.Models.Clinic>
@{
    ViewData["Title"] = Localizer["Clinics"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><i class="bi bi-building me-2"></i>@Localizer["Clinics"]</h1>
        <p class="text-muted mb-0">@Localizer["ClinicsSubtitle"]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>@Localizer["AddClinic"]
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["HeadNurse"]</th>
                        <th>@Localizer["Nurses"]</th>
                        <th>@Localizer["ShiftConfiguration"]</th>
                        <th width="150">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clinic in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@clinic.Name</td>
                            <td>
                                @if (clinic.HeadNurse != null)
                                {
                                    <span class="badge bg-primary">
                                        <i class="bi bi-star-fill me-1"></i>@clinic.HeadNurse.FullName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["NotAssigned"]</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary">@clinic.Nurses.Count(n => n.IsActive) @Localizer["Active"].ToString().ToLower()</span>
                            </td>
                            <td>
                                @foreach (var config in clinic.ShiftConfigurations.OrderBy(c => c.ShiftType))
                                {
                                    var icon = config.ShiftType switch
                                    {
                                        NurseShifts.Models.ShiftType.Morning => "bi-sunrise",
                                        NurseShifts.Models.ShiftType.Afternoon => "bi-sun",
                                        NurseShifts.Models.ShiftType.Night => "bi-moon",
                                        _ => "bi-clock"
                                    };
                                    <span class="badge bg-light text-dark me-1" title="@config.ShiftType: @config.RequiredNurses @Localizer["Nurses"].ToString().ToLower()">
                                        <i class="bi @icon me-1"></i>@config.RequiredNurses
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@clinic.Id" class="btn btn-outline-primary" title="@Localizer["Edit"]">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Configure" asp-route-id="@clinic.Id" class="btn btn-outline-info" title="@Localizer["ConfigureShifts"]">
                                        <i class="bi bi-sliders"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@clinic.Id" class="btn btn-outline-danger" title="@Localizer["Delete"]">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-building fs-1 text-muted"></i>
            <h5 class="mt-3">@Localizer["NoClinicsYet"]</h5>
            <p class="text-muted">@Localizer["GetStartedClinic"]</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>@Localizer["AddClinic"]
            </a>
        </div>
    </div>
}
