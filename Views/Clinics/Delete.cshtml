@model NurseShifts.Models.Clinic
@{
    ViewData["Title"] = Localizer["DeleteClinic"];
}

<div class="row mb-4">
    <div class="col">
        <h1><i class="bi bi-trash me-2 text-danger"></i>@Localizer["DeleteClinic"]</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle text-danger fs-1"></i>
                <h4 class="mt-3">@Localizer["AreYouSure"]</h4>
                <p class="text-muted">
                    @Localizer["AboutToDeleteClinic"] <strong>@Model.Name</strong>.
                    @Localizer["ActionCannotBeUndone"]
                </p>

                @if (Model.Nurses?.Any() == true)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        @Localizer["ClinicHasNurses", Model.Nurses.Count]
                    </div>
                }

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>@Localizer["Cancel"]
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>@Localizer["DeleteClinic"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
